# vox-reader 环境配置示例
# 复制此文件为 .env.local 并填写你的实际配置

# ============================================
# 前端配置
# ============================================

# API 基础 URL - 根据部署环境修改
# 开发环境: http://localhost:3000/api
# 生产环境: https://yourdomain.com/api
# 腾讯云: https://your-tencentcloud-domain.com/api
VITE_API_BASE_URL=http://localhost:3000/api

# TTS 服务提供者 (mock 为浏览器内置朗读)
VITE_TTS_PROVIDER=mock

# 文件上传限制 (MB)
VITE_MAX_UPLOAD_SIZE_MB=50

# 数据存储目录
VITE_DATA_DIR=./data

# 腾讯云翻译区域
VITE_TENCENT_CLOUD_REGION=ap-beijing

# ============================================
# 后端配置
# ============================================

# 服务器端口
PORT=3000

# Node 环境
NODE_ENV=development

# ============================================
# 腾讯云翻译配置（仅后端使用）
# ============================================

# 获取方法：
# 1. 登录腾讯云控制台 https://console.cloud.tencent.com
# 2. 进入 "访问管理" > "API 密钥管理"
# 3. 创建新的密钥对
# 4. 复制 SecretId 和 SecretKey

# 腾讯云 API 密钥 ID
TENCENT_CLOUD_SECRET_ID=AKID1234567890ABCDEF

# 腾讯云 API 密钥 Secret（敏感信息，不要上传到 Git）
TENCENT_CLOUD_SECRET_KEY=abc1234567890defghijk

# 腾讯云服务区域
# 选项: ap-beijing, ap-shanghai, ap-guangzhou, ap-chengdu 等
TENCENT_CLOUD_REGION=ap-beijing

# 腾讯云项目 ID（通常为 0）
TENCENT_CLOUD_PROJECT_ID=0

# ============================================
# 安全提示
# ============================================
#
# ⚠️ 重要：此文件包含敏感信息（API 密钥）
#
# 1. 不要将 .env.local 提交到 Git
# 2. 在生产服务器上才需要配置 TENCENT_CLOUD_SECRET_ID 和 TENCENT_CLOUD_SECRET_KEY
# 3. 定期更换 API 密钥
# 4. 使用 IAM 策略限制密钥的权限
#
# 配置 Git 忽略：
# echo ".env.local" >> .gitignore
# echo ".env" >> .gitignore
