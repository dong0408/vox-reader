# vox-reader 生产环境配置
# 复制此文件为 .env.production 然后使用 npm run build:production

# ⚠️ 生产环境 API 配置
# 不要设置绝对 URL！使用相对路径 /api
# Nginx 会自动将 /api 转发到后端
VITE_API_BASE_URL=

# TTS 配置
VITE_TTS_PROVIDER=mock

# 文件上传限制
VITE_MAX_UPLOAD_SIZE_MB=50

# 数据存储目录
VITE_DATA_DIR=./data

# 腾讯云翻译配置（仅后端使用）
TENCENT_CLOUD_REGION=ap-beijing

# 后端端口（生产环境）
PORT=3000

# 后端腾讯云凭证（后端 server/index.mjs 使用）
# 重要：不要提交这些敏感信息到 git！
# 请在服务器上通过以下方式设置：
# export TENCENT_CLOUD_SECRET_ID="xxx"
# export TENCENT_CLOUD_SECRET_KEY="xxx"
# TENCENT_CLOUD_SECRET_ID=
# TENCENT_CLOUD_SECRET_KEY=
TENCENT_CLOUD_PROJECT_ID=0
